DATABASE_URL=sqlite:///./data/cqa.db
TEAM_NAME=CQA
ORGANIZER_API_URL=
MULTIAI_API_KEY=
MULTIAI_BASE_URL=https://multiai.store/v1
# Verified in authenticated /v1/models catalog; generation not tested yet.
MULTIAI_PRIMARY_MODEL=gpt-6.1-sol
MULTIAI_SECONDARY_MODEL=gemini-3.8-flash
# Existing MULTIAI_MODEL_1 / MULTIAI_MODEL_2 remain supported aliases.
MULTIAI_RESPONSE_FORMAT=json_schema
MULTIAI_TIMEOUT_SECONDS=90
MULTIAI_MAX_OUTPUT_TOKENS=6000
# All paid calls require explicit user approval first.
ALLOW_PAID_CALLS=false
API_BUDGET_USD=10
MULTIAI_MAX_REQUESTS=12
MULTIAI_MAX_BATCH=1
MULTIAI_ALLOW_BULK=false
MULTIAI_ALLOW_REAL_CALLS=false
# Verify against the actual account tariff/top-up. No automatic USD conversion.
MULTIAI_USD_PER_MILLION_CREDITS=
MULTIAI_PRICING_CONFIRMED=false
# Bounded retry wait; large Retry-After causes a safe stop, never an early retry.
MULTIAI_MAX_BACKOFF_SECONDS=30
# Batch concurrency/timeout/attempts/budget are frozen inside each dry-run plan.
# MULTIAI_BATCH_APPROVED_PLAN is set per process only after fresh explicit approval.
